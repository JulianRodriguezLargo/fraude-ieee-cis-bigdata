# Copia este archivo como .env y ajústalo a tu equipo. El archivo .env NO se sube a Git.

# Contraseña para entrar a JupyterLab en http://localhost:8888
JUPYTER_TOKEN=bigdata

# Memoria para Spark. Debe ser menor que la memoria asignada a Docker en .wslconfig.
#   Equipo de 32 GB (Docker con 20 GB) -> 12g
#   Equipo de 16 GB (Docker con 10 GB) -> 6g
SPARK_DRIVER_MEMORY=6g

# Formato de las tablas del lakehouse: delta (lo normal) o parquet (solo para pruebas sin Delta)
TABLE_FORMAT=delta

# Rutas dentro del contenedor (normalmente no hay que cambiarlas)
DATA_RAW=data/raw
LAKEHOUSE=data/lakehouse

# Costos SUPUESTOS para la pregunta P3 (umbral de menor costo). Pendientes de validar con el profesor.
COSTO_CONTRACARGO_USD=25
COSTO_REVISION_USD=5

# MLflow 3.x exige activar el registro en carpeta local (mlruns/)
MLFLOW_ALLOW_FILE_STORE=true
